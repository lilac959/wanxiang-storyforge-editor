{
  "name": "wanxiang-game",
  "account_id": "d1f1acc43863f572e706c82a5d1f1d58",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_COORDINATOR",
        "class_name": "ProjectCoordinator",
        "script_name": "wanxiang-storyforge-editor"
      }
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/game",
      "/game/",
      "/api/*",
      "/assets/chapter01-branch-7.mp4"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "PROJECT_STORE",
      "id": "193077a2c5154127b9e5a02d52d1ec85"
    }
  ],
  "vars": {
    "GAME_ONLY": "true",
    "PLAYER_URL": "https://www.talesparkai.cc/"
  },
  "routes": [
    {
      "pattern": "www.talesparkai.cc",
      "custom_domain": true
    },
    {
      "pattern": "talesparkai.cc",
      "custom_domain": true
    }
  ]
}

{
  "name": "wanxiang-game",
  "account_id": "d1f1acc43863f572e706c82a5d1f1d58",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/assets/chapter01-branch-7.mp4"
    ]
  },
  "r2_buckets": [
    {
      "binding": "PROJECT_STORE",
      "bucket_name": "wanxiang-storyforge-project"
    }
  ],
  "vars": {
    "GAME_ONLY": "true"
  }
}